# =============================================================================
# KAS — PRODUCTION environment template
#
# WINDOWS HOST (the supported production path since Phase D.1) — copy to
# `.env.production` next to the app and restrict it to the service account:
#     Copy-Item .env.production.example .env.production
#     icacls .env.production /inheritance:r /grant:r "$($env:USERNAME):(R,W)"
#
# DOCKER (optional secondary path) — copy NEXT TO compose.production.yml:
#     cp .env.production.example .env.production
#     chmod 600 .env.production
#
# `.env.production` is git-ignored and must never be committed.
#
# The real secrets are NOT set here. They are read from files mounted as
# Docker secrets (see scripts/production/deploy.sh), so their values never
# appear in this file, in `docker inspect`, or in the process environment of
# another container:
#     secrets/session_secret
#     secrets/initial_admin_password
#     secrets/database_url          <-- added in Phase D.1
#
# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL 17, since Phase D.1)
# -----------------------------------------------------------------------------
# DATABASE_URL carries a PASSWORD, so it is never written in this file or in
# compose.production.yml. Supply it one of two ways:
#
#   Windows host (the supported production path):
#     setx DATABASE_URL "postgresql://kas_app:<ENCODED>@localhost:5432/kas"
#   ...or an untracked .env next to the app, readable only by the service user.
#
#   Docker (optional secondary path):
#     write ONE line into secrets/database_url and mount it as DATABASE_URL_FILE
#     postgresql://kas_app:<ENCODED>@host.docker.internal:5432/kas
#
# ⚠️  PERCENT-ENCODE reserved characters in the password, or the URL silently
#     resolves to a different host/database and fails with a confusing
#     "database does not exist" instead of an authentication error:
#         @ -> %40    : -> %3A    / -> %2F    ? -> %3F    # -> %23
#         % -> %25    & -> %26    [ -> %5B    ] -> %5D    space -> %20
#     PowerShell can do it for you:  [uri]::EscapeDataString($plain)
#
# DIRECT_DATABASE_URL is OPTIONAL and should be left unset here. It exists for
# a future deployment behind a connection pooler (PgBouncer), where migrations
# must bypass the pool. PostgreSQL runs directly on the Windows host, so there
# is no pooler and DATABASE_URL is used for migrations too.
#
# The application REFUSES TO START in production on a `file:` (SQLite) URL.
# That is deliberate: after the D.1 cutover a leftover SQLite URL would quietly
# boot the app against an empty local database instead of PostgreSQL.
# =============================================================================

# --- Public identity -------------------------------------------------------
# The domain Caddy serves and requests a certificate for. DNS A/AAAA records
# must already point at this server. No default: deployment fails without it.
APP_DOMAIN=dispatch.example.invalid

# The exact public origin, including scheme. Must match APP_DOMAIN and must be
# https:// in production. This is the app's entire same-origin allowlist — Kas
# serves its own frontend and emits no CORS headers at all.
APP_ORIGIN=https://dispatch.example.invalid

# Contact address for the ACME (Let's Encrypt) account — used for expiry
# warnings only. Optional but recommended.
ACME_EMAIL=ops@example.invalid

# --- Release ---------------------------------------------------------------
# The git tag or commit being deployed. Recorded in every backup manifest so a
# restored snapshot can be matched to the code that produced it.
APP_RELEASE_REF=v0.0.0
# Image tag applied to the built app image (used by rollback.sh).
APP_IMAGE_TAG=v0.0.0

# --- Runtime (WINDOWS — the supported path) ---------------------------------
#
# THESE TWO LINES ARE LOAD-BEARING. Leaving them out is what made an entire
# deployment serve nothing but the API.
#
# NODE_ENV has no default of "production": the schema defaults it to
# `development`, and `serveClient` is `SERVE_CLIENT ?? isProduction`. So an
# install whose .env omits NODE_ENV runs as development, never mounts
# express.static, and answers every non-API request — index.html,
# manifest.webmanifest, sw.js, /assets/* — with a JSON 404. The API keeps
# working perfectly, which is what makes the fault so hard to see.
#
# This block used to be absent because these variables "are set by
# compose.production.yml". That is true of the Docker path and false of this
# one: on Windows there is no compose file, and nothing else sets them.
NODE_ENV=production

# Serve the built client from this same process, on one origin. Without it the
# PWA has no manifest and no service worker, so Kas cannot be installed.
SERVE_CLIENT=true

# The single port that serves both the API and the app. The tunnel or reverse
# proxy must point HERE — never at the Vite dev server on 5173.
PORT=3001

# --- Runtime (DOCKER — secondary path) --------------------------------------
# Under compose.production.yml the three settings above, plus DATABASE_URL,
# TRUST_PROXY, SESSION_COOKIE_SECURE and every persistent path, are supplied by
# the compose file and must NOT be overridden here — the app refuses to start
# with an insecure combination.

# Session lifetime / rolling idle window, in hours.
SESSION_MAX_AGE_HOURS=12

# Largest accepted upload (proof screenshots, issue photos), in megabytes.
# Keep the Caddyfile's request_body max_size comfortably above this.
MAX_UPLOAD_MB=10

# error | warn | info | debug
LOG_LEVEL=info

# --- Login brute-force protection ------------------------------------------
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# --- Initial administrator -------------------------------------------------
# Username and display name only. The PASSWORD is supplied through the
# secrets/initial_admin_password file, never here.
# Prefer creating the Admin interactively instead:
#     docker compose -f compose.production.yml exec app npm run prod:create-admin
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_FULL_NAME=

# --- Persistent storage paths (WINDOWS host path) ---------------------------
# EVERY ONE OF THESE MUST BE ABSOLUTE IN PRODUCTION. The app refuses to start
# otherwise, and the refusal is the point: a relative path resolves INSIDE the
# application directory, which a release REPLACES. Anything written there is
# destroyed by the next deployment, silently, because writing it succeeded.
#
# Put them on a persistent volume OUTSIDE the application directory, e.g.
# C:\KasData\… on the Windows host or /data/… under Docker.
PROOF_UPLOAD_DIR=
ISSUE_UPLOAD_DIR=
# Chứng từ attachments (guest images, charge documents, card images).
CHARGE_UPLOAD_DIR=
# Chat box message images (reception ↔ Admin). Same rules; images only.
CHAT_UPLOAD_DIR=
BACKUP_DIR=

# --- Chứng từ: card-number encryption ---------------------------------------
# AES-256-GCM key for card numbers at rest. REQUIRED before the Chứng từ module
# can store or reveal a card number; the rest of the app runs without it.
#
# Supply it as a FILE, not as a value here — the path keeps the key out of this
# template, out of the process environment as a literal, and out of any backup
# of this file. One line, base64 of exactly 32 random bytes. Generate with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Restrict the file to SYSTEM and Administrators only.
#
# EVERY ENVIRONMENT NEEDS ITS OWN KEY — never the development one. LOSING IT
# MAKES EVERY STORED CARD NUMBER UNRECOVERABLE, so it belongs in the backup
# procedure beside the database.
CARD_ENCRYPTION_KEY_FILE=

# Web Push ("Bật thông báo") — the device notifications for operational
# assignments. Without both keys nothing is pushed and the in-app bell still
# works. ONE KEY PAIR PER ENVIRONMENT; changing it means every device must press
# "Bật thông báo" again. Generate a pair (public key is safe to share, the
# private key is a secret and never leaves the server):
#   node -e "const c=require('crypto').createECDH('prime256v1');c.generateKeys();console.log('VAPID_PUBLIC_KEY='+c.getPublicKey('base64url'));console.log('VAPID_PRIVATE_KEY='+c.getPrivateKey('base64url'))"
# Push requires the HTTPS production origin (or localhost).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who the push services may contact about this sender.
VAPID_SUBJECT=mailto:it@example.com

# --- Optional features -----------------------------------------------------
# Advisory OCR of proof screenshots. Requires the optional tesseract.js
# dependency; leave false unless it has been installed and tested.
PROOF_OCR_ENABLED=false

# --- Developer tooling: MUST stay false ------------------------------------
# The application REFUSES TO START in production if this is true. Demo data
# generation, the reception_test branch switcher and the demo-clear tools must
# never exist in a production deployment.
ENABLE_DEV_TEST_TOOLS=false

# Technical inspection ("Nghiệm thu" by Quản lý kỹ thuật). Implemented but not
# yet in operational use: keep false until the workflow is switched on.
TECHNICAL_INSPECTION_ENABLED=false

# =============================================================================
# Variables referenced by the app that are set inside compose.production.yml
# (listed here for completeness — do not duplicate them):
#
#   NODE_ENV=production            SESSION_COOKIE_SECURE=true
#   PORT=3001                      TRUST_PROXY=1
#   SERVE_CLIENT=true              SESSION_SECRET_FILE=/run/secrets/session_secret
#   DATABASE_URL_FILE=/run/secrets/database_url
#   INITIAL_ADMIN_PASSWORD_FILE=/run/secrets/initial_admin_password
#   PROOF_UPLOAD_DIR=/data/uploads/booking-proofs      (the upload directories)
#   ISSUE_UPLOAD_DIR=/data/uploads/issue-photos
#   CHARGE_UPLOAD_DIR=/data/uploads/charge-documents
#   CHAT_UPLOAD_DIR=/data/uploads/chat-attachments
#   BACKUP_DIR=/data/backups                           (the backup directory)
#   CARD_ENCRYPTION_KEY_FILE=/run/secrets/card_encryption_key
#
# On the WINDOWS host path there is no compose file, so all of the above must
# be set in the service environment instead. scripts/production/windows/
# contains the PowerShell equivalents of every operator command.
# =============================================================================
