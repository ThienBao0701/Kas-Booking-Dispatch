# ==============================================
# hotel-booking-dispatch — environment variables
# Copy this file to .env and adjust the values.
# ==============================================

# --- Server ---
# DEVELOPMENT PORT. A production install runs on 3001 and gets its settings
# from .env.production.example, not from this file. Development binds 3002 so
# both can run at once — and so a dev frontend can never silently proxy /api
# into a production backend that happens to be listening.
PORT=3002
NODE_ENV=development

# --- Database ---
#
# DEVELOPMENT USES ITS OWN DATABASE: kas_dev. It is disposable — seeded from
# scripts, never a copy of production — so anything here can be dropped and
# rebuilt without a conversation.
#
# NEVER point this at kas_dev_cn1, kas_d1_test or kas_production. All three
# hold LIVE data, whatever their names suggest: kas_dev_cn1 was called the
# development database for weeks while it was serving kasbookingapp.com, and a
# dev backend pointed at it reads and writes real guest records with nothing on
# screen looking wrong. Start-Dev.cmd refuses to start if it finds any of them.
#
# The automated server suite uses a THIRD database, kas_test, supplied through
# KAS_TEST_DATABASE_URL — never this variable. See server/src/d1/testDatabase.ts.
DATABASE_URL="postgresql://kas_app:PASSWORD@127.0.0.1:5432/kas_dev?schema=public"

# --- Chứng từ (charge documents): card-number encryption ---
# AES-256-GCM key for card numbers at rest. REQUIRED before the Chứng từ module
# can store or reveal a card number; every other part of the app runs without it.
#
# 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# DELIBERATELY NOT DERIVED FROM SESSION_SECRET. Rotating the session secret is a
# routine action that only logs people out; if card numbers hung off it, that
# same action would silently destroy every stored card number.
#
# May instead be supplied as a file — CARD_ENCRYPTION_KEY_FILE=/run/secrets/card_key
# — which keeps it out of the process environment (Docker/systemd secrets).
#
# EVERY ENVIRONMENT NEEDS ITS OWN KEY. Never copy the development key anywhere
# else. Losing a key makes that environment's stored card numbers unrecoverable,
# so it belongs in the backup procedure beside the database.
CARD_ENCRYPTION_KEY=

# Where Chứng từ attachments are written (same rules as proofs: private disk,
# never served as static content).
CHARGE_UPLOAD_DIR=server/uploads/charge-documents

# Where Chat box message images are written (same rules; images only, never
# served as static content).
CHAT_UPLOAD_DIR=server/uploads/chat-attachments

# --- Sessions ---
# Secret that signs the session cookie. REQUIRED, at least 16 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Send the session cookie only over HTTPS. Keep false for local HTTP
# development; set true in production when the app is served over TLS.
SESSION_COOKIE_SECURE=false
# Session lifetime in hours. Also the rolling idle window each request refreshes.
SESSION_MAX_AGE_HOURS=12

# --- Login rate limiting ---
# Max login attempts per IP per window before requests are throttled (429).
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# --- Password hashing ---
# bcrypt work factor (4-15). 10 is a sound default; leave unset to use it.
# BCRYPT_COST=10

# --- Initial administrator account ---
# Created automatically on first server start if no matching account exists.
# On later restarts an existing admin is never overwritten.
# The admin is forced to change this password at first login.
# There is NO built-in default account: in production the server refuses to
# start unless all three values below are set, so it can never fall back to a
# predictable public password. Choose a strong, private initial password.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-immediately
INITIAL_ADMIN_FULL_NAME=Quản trị viên

# Proof-of-creation screenshot storage.
# Where receptionist proof screenshots are written on the server filesystem.
# Only metadata + a safe relative path are stored in SQLite (never image bytes).
# Relative paths are resolved from the repository root. Keep this directory
# backed up together with the SQLite database. Default (development):
PROOF_UPLOAD_DIR=server/uploads/booking-proofs

# Where receptionist issue-report photos are written (same rules as proofs).
ISSUE_UPLOAD_DIR=server/uploads/issue-photos

# --- Proof OCR (advisory extraction only) ---
# Read operational text (booking code, dates, total, payment…) from a proof
# screenshot to help the Admin. It is ADVISORY ONLY: OCR never approves, rejects
# or compares a proof — the Admin always checks the image themselves.
#
# Keep OCR OFF by default. When off, proof upload still works, the Admin views
# the image manually, and each analysis is recorded as DISABLED.
PROOF_OCR_ENABLED=false
# Tesseract language packs, e.g. "eng+vie". Only used when PROOF_OCR_ENABLED=true.
# Enabling real OCR also requires installing the optional dependency:
#   npm install tesseract.js -w server
PROOF_OCR_LANGUAGE=eng+vie

# --- Developer test tools (DEVELOPMENT ONLY) ---
# Enables demo-data generation, the reception_test branch switcher, and the demo
# clear tools. NEVER enable this in production — even if set true, the tools also
# refuse to run whenever NODE_ENV=production. Keep false unless you are testing
# the 8 branches locally. See docs/testing-8-branches.md.
ENABLE_DEV_TEST_TOOLS=false

# Technical inspection ("Nghiệm thu" by Quản lý kỹ thuật). Implemented but not
# yet in operational use: keep false until the workflow is switched on.
TECHNICAL_INSPECTION_ENABLED=false
