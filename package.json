{
  "name": "hotel-booking-dispatch",
  "version": "0.1.0",
  "private": true,
  "description": "Internal hotel booking dispatch and tracking system — Booking.com reservations dispatched to 8 hotel branches",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "start": "npm run start -w server",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/production/windows/Package-Kas.ps1",
    "release:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/production/windows/Package-Kas.ps1 -BuildSetupExe",
    "launch": "node server/dist/service/runner.js",
    "service": "node server/dist/service/runner.js --service",
    "service:stop": "node server/dist/service/runner.js --stop",
    "test": "npm run test -w server && npm run test -w client",
    "lint": "npm run lint -w server && npm run lint -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:seed": "tsx server/src/db/seed.ts",
    "data:prepare-production": "tsx server/src/scripts/prepareProduction.ts",
    "prod:seed": "node server/dist/scripts/productionSeed.js",
    "prod:create-admin": "node server/dist/scripts/createAdmin.js",
    "prod:backup": "node server/dist/scripts/backup.js",
    "prod:restore:safe": "node server/dist/scripts/restore.js --safe",
    "prod:restore": "node server/dist/scripts/restore.js",
    "d1:fixture": "tsx server/src/scripts/d1Fixture.ts",
    "d1:transfer": "tsx server/src/scripts/d1Transfer.ts",
    "d1:verify": "tsx server/src/scripts/d1Verify.ts",
    "d1:drill": "tsx server/src/scripts/d1RestoreDrill.ts"
  },
  "dependencies": {
    "prisma": "^6.3.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
